#!/bin/bash

# Show the settings the syzyf97.cava bar widget is using right now.
#
# Merges the manifest defaults with the widget's entry in shell.json and
# applies the same limits as BarWidget.qml, so the output shows what the
# widget actually runs with, not only what was typed into shell.json.

set -o pipefail

PLUGIN_ID="syzyf97.cava"
SHELL_JSON="${OMARCHY_SHELL_JSON:-$HOME/.config/omarchy/shell.json}"

fail() {
  echo "omarchy-cava-settings: $*" >&2
  exit 1
}

# The manifest sits one directory above this script. Resolve symlinks so the
# script also works when linked into ~/.local/bin.
script_dir=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")
manifest="$script_dir/../manifest.json"
[[ -f $manifest ]] || manifest="$HOME/.config/omarchy/plugins/$PLUGIN_ID/manifest.json"

# Every setting with its allowed values, read from the manifest schema so the
# help never drifts from what the widget accepts.
settings_help() {
  if ! command -v jq >/dev/null || [[ ! -f $manifest ]]; then
    echo "  (settings list unavailable: needs jq and the plugin manifest.json)"
    return
  fi
  local width=${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}
  (( width > 100 )) && width=100
  (( width < 50 )) && width=50
  # Padding is done in jq, which counts characters; printf would count the
  # three bytes of the en dash and misalign the columns.
  jq -r '
    def pad($n): . + (" " * ([$n - length, 1] | max));
    .barWidget.schema[]
    | (if .type == "integer" then "\(.min)–\(.max)"
       elif .type == "enum" then (.options | join(" | "))
       else "text" end) as $values
    | "\(.key | pad(17))\($values | pad(24))default: \(.defaultValue | tostring)\t\(.description // "")"
  ' "$manifest" | while IFS=$'\t' read -r heading description; do
    printf '  %s\n' "$heading"
    fold -s -w $((width - 6)) <<<"$description" | sed 's/^/      /; s/ *$//'
    echo
  done
}

usage() {
  cat <<USAGE
Usage: omarchy-cava-settings [--json | --sources | --help]

Shows the settings every $PLUGIN_ID widget on the bar is using: the value in
use, where it comes from (default or shell.json), and whether it was changed to
fit the allowed values.

Options:
  (none)        table of the current settings of each widget
  --json        JSON array with the section, index and settings of each widget
  --sources     audio devices that can be used as audioSource
  -h, --help    this help

Settings:
USAGE
  settings_help
  cat <<USAGE
Changing settings:
  omarchy bar set $PLUGIN_ID <setting> <value>            text and choice values
  omarchy bar set $PLUGIN_ID <setting> <number> --json    numbers

  Changes apply to the bar immediately. Numbers outside the range are clamped
  to the nearest limit. Settings can also be edited by hand in the widget entry
  of ~/.config/omarchy/shell.json.

  With several visualizers on the bar, pick one by its position, as shown in
  the table: --from-section <left|center|right> --from-index <n>

Examples:
  omarchy bar set $PLUGIN_ID audioSource input
  omarchy bar set $PLUGIN_ID bars 16 --json
  omarchy bar set $PLUGIN_ID color accent
  omarchy bar set $PLUGIN_ID lowFreq 20 --json
  omarchy bar set $PLUGIN_ID highFreq 250 --json
  omarchy bar set $PLUGIN_ID sensitivity 800 --json --from-section right --from-index 0
USAGE
}

json=false
sources=false
case "${1:-}" in
  "") ;;
  --json) json=true ;;
  --sources) sources=true ;;
  -h | --help) usage; exit 0 ;;
  *)
    echo "omarchy-cava-settings: unknown option '$1'" >&2
    echo "Run 'omarchy-cava-settings --help' for options and all settings." >&2
    exit 1
    ;;
esac
(( $# <= 1 )) || fail "expected one option at most (see --help)"

command -v jq >/dev/null || fail "jq is required"
[[ -f $manifest ]] || fail "manifest.json not found"

# Audio sinks and sources known to PipeWire, as [{name, description, kind}].
devices='[]'
if command -v pw-dump >/dev/null; then
  devices=$(pw-dump 2>/dev/null | jq -c '
    (map(select(.type == "PipeWire:Interface:Metadata" and .props."metadata.name" == "default"))
      | [.[].metadata[]? | {(.key): (.value.name? // "")}] | add // {}) as $defaults
    | [ .[] | select(.type == "PipeWire:Interface:Node") | .info.props
        | select(."media.class" == "Audio/Sink" or ."media.class" == "Audio/Source")
        | { name: ."node.name",
            description: (."node.description" // ."node.nick" // ""),
            kind: (if ."media.class" == "Audio/Sink" then "output" else "input" end) }
        | .default = (.name == $defaults["default.audio.\(if .kind == "output" then "sink" else "source" end)"]) ]
  ' || echo '[]')
fi

if [[ $sources == true ]]; then
  echo "Use one of these as the audioSource setting:"
  echo
  {
    printf 'VALUE\tDEVICE\n'
    printf 'output\tdefault output — whatever is playing\n'
    printf 'input\tdefault microphone\n'
    jq -r '.[] | [.name, "\(.kind): \(.description)\(if .default then " (default)" else "" end)"] | @tsv' <<<"$devices"
  } | column -t -s $'\t'
  echo
  echo "Example: omarchy bar set $PLUGIN_ID audioSource input"
  exit 0
fi

if [[ -f $SHELL_JSON ]]; then
  shell_json="$SHELL_JSON"
else
  shell_json=/dev/null
fi

report=$(jq -n \
  --arg id "$PLUGIN_ID" \
  --slurpfile manifest "$manifest" \
  --argjson devices "$devices" \
  --slurpfile shell <(cat "$shell_json" 2>/dev/null || echo '{}') '
  # Mirror clampInt() and isOn() from BarWidget.qml.
  def num:
    if type == "number" then .
    elif type == "boolean" then (if . then 1 else 0 end)
    elif type == "string" then (if test("^\\s*$") then 0 else (tonumber? // null) end)
    else null end;
  def clamp($min; $max):
    (num) as $n
    | if $n == null then $min
      else ($n | round) as $r | if $r < $min then $min elif $r > $max then $max else $r end
      end;
  # Mirror cavaSource in BarWidget.qml. Devices are only checked when pw-dump
  # could list them, so an empty list never marks a name as unknown.
  def source_of:
    (tostring | gsub("^\\s+|\\s+$"; "")) as $v
    | ($v | ascii_downcase) as $l
    | if $l == "" or $l == "output" or $l == "auto" then {value: "output"}
      elif $l == "input" or $l == "auto_input" then {value: "input"}
      elif ($v | test("^[A-Za-z0-9._:@+-]+$") | not) then {value: "output", warning: "invalid name, using output"}
      else ($v | sub("\\.monitor$"; "")) as $name
        | ([$devices[] | select(.name == $name)][0]) as $device
        | if $device == null then
            {value: $v, warning: (if ($devices | length) > 0 then "no such device, cava falls back to the default microphone" else null end)}
          else {value: $v, device: "\($device.kind): \($device.description)"}
          end
      end;
  def on: . == true or ((. | tostring | ascii_downcase) as $v | $v == "on" or $v == "true");

  ($manifest[0].barWidget.defaults // {}) as $defaults
  | def describe($entry):
      def raw($key): if $entry | has($key) then $entry[$key] else $defaults[$key] end;
      (raw("lowFreq") | clamp(20; 19900)) as $low
      | (raw("audioSource") | source_of) as $source
      | {
          audioSource: $source.value,
          bars: (raw("bars") | clamp(4; 32)),
          framerate: (raw("framerate") | clamp(10; 60)),
          lowFreq: $low,
          highFreq: ([$low + 100, (raw("highFreq") | clamp(120; 20000))] | max),
          sensitivity: (raw("sensitivity") | clamp(10; 5000)),
          autoSensitivity: (if raw("autoSensitivity") | on then "On" else "Off" end),
          color: (if (raw("color") | tostring | ascii_downcase) == "accent" then "accent" else "foreground" end),
          hideWhenSilent: (if raw("hideWhenSilent") | on then "On" else "Off" end)
        } as $effective
      | {
          settings: $effective,
          rows: [
            $effective | to_entries[] | .key as $k | {
              key: $k,
              value: .value,
              source: (if $entry | has($k) then "shell.json" else "default" end),
              given: (if $entry | has($k) then $entry[$k] else null end)
            }
            | .note = (
                if $k == "audioSource" and $source.warning then $source.warning
                elif $k == "audioSource" and $source.device then $source.device
                elif .source == "shell.json" and .given != .value then "set to \(.given | tojson)"
                else "" end)
          ],
          unknown: [$entry | keys[] | . as $k | select($k != "id" and ($effective | has($k) | not))]
        };

  # Every copy of the widget on the bar, with the section and index that
  # `omarchy bar set ... --from-section --from-index` expects.
  [ ($shell[0].bar.layout // {}) | to_entries[]
    | .key as $section
    | (.value // []) | to_entries[]
    | select(.value.id? == $id)
    | { section: $section, index: .key } + describe(.value)
  ] as $instances
  | { instances: $instances, defaults: describe({}) }
')
[[ -n $report ]] || fail "could not read settings"

if [[ $json == true ]]; then
  jq '[.instances[] | {section, index, settings}]' <<<"$report"
  exit 0
fi

print_table() {
  {
    printf 'SETTING\tVALUE\tFROM\tNOTE\n'
    jq -r '.rows[] | [.key, (.value | tostring), .source, .note] | @tsv' <<<"$1"
  } | column -t -s $'\t'

  local unknown
  unknown=$(jq -r '.unknown | join(", ")' <<<"$1")
  [[ -z $unknown ]] || printf '\nIgnored keys in shell.json: %s\n' "$unknown"
}

count=$(jq '.instances | length' <<<"$report")
if (( count == 0 )); then
  echo "$PLUGIN_ID — not in the bar (enable it with: omarchy plugin enable $PLUGIN_ID)"
  echo "Defaults it would start with:"
  echo
  print_table "$(jq '.defaults' <<<"$report")"
  echo
  echo "All settings and their allowed values: omarchy-cava-settings --help"
  exit 0
fi

for (( i = 0; i < count; i++ )); do
  instance=$(jq ".instances[$i]" <<<"$report")
  section=$(jq -r '.section' <<<"$instance")
  index=$(jq -r '.index' <<<"$instance")
  (( i == 0 )) || echo
  if (( count == 1 )); then
    echo "$PLUGIN_ID — in the $section section of the bar"
  else
    echo "$PLUGIN_ID #$((i + 1)) — $section section, index $index (change with: omarchy bar set $PLUGIN_ID <key> <value> --from-section $section --from-index $index)"
  fi
  echo
  print_table "$instance"
done

echo
echo "All settings and their allowed values: omarchy-cava-settings --help"
